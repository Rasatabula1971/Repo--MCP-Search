# ---- Core ----
# TCP form (works on Windows, macOS, Linux). Adjust user, password, port.
# NOTE: PostgreSQL installer on Windows sometimes picks 5433 if 5432 is taken.
# Check with `netstat -ano | findstr LISTEN` if psql refuses on 5432.
ENVIRONMENT=local
DATABASE_URL=postgresql://cip:cip@localhost:5432/cip_local
TEST_DATABASE_URL=postgresql://cip:cip@localhost:5432/cip_test

# Linux users running Postgres over a Unix socket can use this form:
# DATABASE_URL=postgresql://cip@/cip_local?host=/tmp/pgsock
# TEST_DATABASE_URL=postgresql://cip@/cip_test?host=/tmp/pgsock

# ---- Source providers ----
# Personal access token for GitHub. Not required for reading public repos,
# but it raises the rate limit substantially. Create one at
# https://github.com/settings/tokens (no scopes needed for public read).
GITHUB_TOKEN=

# ---- Model providers ----
# Identity, tier, quota and retention posture live in providers.yaml.
# Only secrets live here.
MODEL_PROVIDERS_CONFIG=./config/providers.yaml
GEMINI_API_KEY=

# ---- Budget ceilings ----
# The scheduler refuses to start a run if these are unset.
BUDGET_MODEL_CALLS_PER_RUN=50
BUDGET_MODEL_CALLS_PER_MONTH=1000
BUDGET_WALLCLOCK_MINUTES_PER_RUN=15
BUDGET_SANDBOX_MINUTES_PER_RUN=0