# ---- Core ----
ENVIRONMENT=local
DATABASE_URL=postgresql://cip:@/tmp/pgsock/cip_local
TEST_DATABASE_URL=postgresql://cip:@/tmp/pgsock/cip_test

# ---- Source providers ----
GITHUB_TOKEN=github_pat_...

# ---- Model providers ----
# Identity, tier, quota and retention posture live in providers.yaml.
# Only secrets live here.
MODEL_PROVIDERS_CONFIG=./config/providers.yaml
GEMINI_API_KEY=

# ---- Budget ceilings (PDR §29.6) ----
# The scheduler refuses to start a run if these are unset.
BUDGET_MODEL_CALLS_PER_RUN=50
BUDGET_MODEL_CALLS_PER_MONTH=1000
BUDGET_WALLCLOCK_MINUTES_PER_RUN=15
BUDGET_SANDBOX_MINUTES_PER_RUN=0
